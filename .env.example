# =====================================================================
# 达证通（达课）部署配置 —— 复制为 .env 后按需修改
# ./init.sh 会自动完成复制并生成随机密码；之后直接改 .env 再
# `docker compose up -d` 即可生效（改密码类变量还需重建对应数据卷，见 README）
# =====================================================================

# ---- 镜像（Docker Hub 命名空间，随正式发布地址调整）----
DOCKER_NAMESPACE=dake
IMAGE_TAG=3.5.2

# ---- 部署主机对外地址 ----
# 浏览器可达的 IP 或域名（不含协议和端口）。题目图片 URL、跨域白名单、
# AI 回调信任地址都基于它派生。本机体验用 localhost；局域网/公网部署填实际地址。
PUBLIC_HOST=localhost

# ---- 端口 ----
TEACHER_WEB_PORT=10026
STUDENT_WEB_PORT=10027
APP_PORT=10025
MINIO_PORT=9000

# ---- 数据库 ----
DB_NAME=dake
DB_USERNAME=postgres
# init.sh 首次运行会自动生成随机值；⚠ 已导入数据后修改无效（数据卷内仍是旧密码）
DB_PASSWORD=

# ---- Redis ----
# init.sh 首次运行会自动生成随机值
REDIS_PASSWORD=

# ---- MinIO 对象存储 ----
MINIO_ROOT_USER=minio
# init.sh 首次运行会自动生成随机值（至少 8 位）
MINIO_ROOT_PASSWORD=

# ---- Judge0 判题（--profile judging）----
JUDGE0_REDIS_PASSWORD=judge0redis2024
# 不启用判题时设 false：代码题自动转为人工批改
JUDGE0_ENABLED=true

# ---- 微信 token 签名密钥（init.sh 自动生成，无需手填）----
TOKEN_SIGN_KEY=
